# Copy to keystore.properties (gitignored) and fill in absolute paths / secrets.
# NEVER commit keystore.properties, *.jks, or *.keystore.
#
# Kai's release keystore lives outside git, e.g. Project store:
#   internal/android-release-keystore/mytimetree-release.jks
# See that folder's README for passwords.

storeFile=/absolute/path/to/mytimetree-release.jks
storePassword=REPLACE_ME
keyAlias=mytimetree
keyPassword=REPLACE_ME
