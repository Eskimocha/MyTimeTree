{
  "appId": "com.mytimetree.app",
  "appName": "MyTimeTree",
  "webDir": "www",
  "bundledWebRuntime": false,
  "ios": {
    "contentInset": "never",
    "scheme": "MyTimeTree"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 800,
      "backgroundColor": "#eef8f1"
    }
  }
}
