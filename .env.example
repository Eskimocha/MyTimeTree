# AI Builder Space (from API Explorer / MCP)
# Get token at https://space.ai-builders.com/explorer after sign-in
AI_BUILDER_TOKEN=your_token_here
AI_BUILDER_BASE_URL=https://space.ai-builders.com/backend/v1
AI_BUILDER_MODEL=grok-4-fast
DEPLOYMENT_TARGET=development

# Runtime port (platform injects PORT on deploy; default 8000 locally)
PORT=8000

# Optional other providers used by tools/
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_MODEL_DEPLOYMENT=gpt-4o-ms
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
